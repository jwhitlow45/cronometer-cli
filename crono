SHORTEST_NAME_START = 2
# Grams in each mass unit, and milliliters in each volume unit, in US measures.
MASS_UNITS = {"g": 1, "kg": 1000, "oz": 28.349523125, "lb": 453.59237}
VOLUME_UNITS = {"ml": 1, "L": 1000, "tsp": 4.92892159375, "tbsp": 14.78676478125, "fl oz": 29.5735295625, "cup": 236.5882365}

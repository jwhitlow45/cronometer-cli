#compdef crono

# Completes crono's commands, saved food names for "crono log", and after
# NAME: or NAME:AMOUNT the units that food's amount can be given in.

# Reading a food's units takes a call to Cronometer, so each shell keeps them once read.
typeset -gA _crono_units

# Completes one word of crono log. foods is the saved names array that _crono sets.
_crono_log_word() {
  if [[ $PREFIX != *:* ]]; then
    compadd "$@" -a foods
    return
  fi
  local name=${PREFIX%%:*}
  [[ -n $name ]] || return 1
  compset -P '*:'
  # The amount, and a space after it when the word is quoted, as in 'oat-milk:200 kc'.
  compset -P '[0-9./]# #'
  if [[ -z ${_crono_units[$name]} ]]; then
    _crono_units[$name]=$(_call_program units crono list --units ${(q)name} 2>/dev/null)
  fi
  local -a units=(${(f)_crono_units[$name]})
  # The list shows each unit as crono names it, and inserts it without spaces, so fl oz goes in as floz. crono reads both.
  local -a words=(${units// /})
  # -V keeps crono's order, which puts the food's own serving sizes first.
  _wanted -V units expl unit compadd -M 'm:{a-zA-Z}={A-Za-z}' -d units -a words
}

_crono() {
  local -a commands=(
    'login:save your Cronometer login in the Keychain'
    'list:list saved foods'
    'delete:delete saved foods'
    'log:log saved foods, or show the diary when given none'
    'search:search Cronometer foods to log or save one'
    'diary:show what is logged for a day'
    'unlog:choose entries logged on a day and remove them'
    'undo:remove the foods from the last log'
    'meals:show or set the times that pick a meal when no meal flag is given'
  )
  if (( CURRENT == 2 )); then
    _describe command commands
    return
  fi

  local command=$words[2]
  # Drop "crono" so _arguments reads the subcommand as the command name.
  shift words
  (( CURRENT-- ))
  local -a foods
  [[ $command == (log|delete) ]] && foods=(${(f)"$(_call_program foods crono list --names 2>/dev/null)"})
  local meals='(-b --breakfast -l --lunch -d --dinner -s --snacks -u --uncategorized)'
  local -a date_and_meal=(
    '(-D --date)'{-D,--date}'[day to log]:date:(today yesterday mon tue wed thu fri sat sun)'
    "$meals"{-b,--breakfast}'[log to Breakfast]'
    "$meals"{-l,--lunch}'[log to Lunch]'
    "$meals"{-d,--dinner}'[log to Dinner]'
    "$meals"{-s,--snacks}'[log to Snacks]'
    "$meals"{-u,--uncategorized}'[log to Uncategorized]'
  )
  case $command in
    log)
      _arguments $date_and_meal '*:saved food:_crono_log_word'
      ;;
    search)
      _arguments $date_and_meal '*:search words: '
      ;;
    delete)
      _arguments '*:saved food:compadd -a foods'
      ;;
    meals)
      _arguments \
        '(-b --breakfast)'{-b,--breakfast}'[when breakfast starts]:time: ' \
        '(-l --lunch)'{-l,--lunch}'[when lunch starts]:time: ' \
        '(-d --dinner)'{-d,--dinner}'[when dinner starts]:time: ' \
        '--off[stop picking meals by time]'
      ;;
    diary|unlog)
      _arguments '(-D --date)'{-D,--date}'[day]:date:(today yesterday mon tue wed thu fri sat sun)'
      ;;
    *)
      return 1
      ;;
  esac
}

_crono "$@"
